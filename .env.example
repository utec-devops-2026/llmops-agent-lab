# Copia este archivo como .env y completa tus valores. .env no se sube a git.
# Cárgalo en la terminal con:  set -a; source .env; set +a

# LLM (obligatorio: el agente necesita un modelo real que sepa usar herramientas)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Segundos de espera entre tareas en el eval y el replay (límite de tokens por minuto)
PAUSA_ENTRE_TAREAS=22
